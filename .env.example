# =============================================================================
# Aletheia — example environment. Copy to `.env` and fill in.
#   cp .env.example .env
# `.env` is git-ignored. NEVER commit real credentials, never log them.
# Every value below is consumed in exactly one place: core/config.py.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CockroachDB — WRITE path (ingest service ONLY holds these credentials).
#    Agents never see a DSN (see CLAUDE.md §5.3).
# -----------------------------------------------------------------------------
# Local dev (docker compose up -d; insecure single node):
ALETHEIA_CRDB_DSN=postgresql://root@localhost:26257/aletheia?sslmode=disable
# Host ports / image tag for the local container (only if the defaults collide):
# CRDB_SQL_PORT=26257
# CRDB_UI_PORT=8081
# CRDB_IMAGE_TAG=v25.4.13
# Cloud (paste the "General connection string" from the CockroachDB Cloud console,
# with database aletheia and sslmode=verify-full):
# ALETHEIA_CRDB_DSN=postgresql://<user>:<password>@<host>:26257/aletheia?sslmode=verify-full

# -----------------------------------------------------------------------------
# 2. CockroachDB Managed MCP Server — READ path for the agent fleet (read-only).
# -----------------------------------------------------------------------------
ALETHEIA_MCP_URL=https://cockroachlabs.cloud/mcp
ALETHEIA_MCP_API_KEY=

# -----------------------------------------------------------------------------
# 3. ccloud CLI — control plane + chaos engineering (E2).
# -----------------------------------------------------------------------------
COCKROACH_API_KEY=
ALETHEIA_CLUSTER_ID=

# -----------------------------------------------------------------------------
# 4. AWS — Bedrock (fleet models + embeddings), S3 (artifacts), Lambda.
#    Prefer a named profile or an instance role over long-lived keys.
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
# AWS_PROFILE=   # leave commented out unless you use a named profile
ALETHEIA_S3_BUCKET=

# Fleet model. VERIFY the exact id in the Bedrock console for AWS_REGION before
# relying on it (CLAUDE.md §11). Inference-profile ids are prefixed `us.`.
ALETHEIA_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Embedding model. Titan Text Embeddings V2 -> 1024 dims, must match
# ALETHEIA_EMBEDDING_DIM and the VECTOR(1024) column in infra/ddl.sql.
ALETHEIA_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
ALETHEIA_EMBEDDING_DIM=1024

# -----------------------------------------------------------------------------
# 5. Ingest service — per-agent auth + immune gate.
#    Server-side secret used to derive/verify per-agent HMAC signatures.
# -----------------------------------------------------------------------------
ALETHEIA_INGEST_URL=http://localhost:8000
ALETHEIA_INGEST_HMAC_SECRET=

# -----------------------------------------------------------------------------
# 6. Demo app — guards the destructive buttons (chaos, attack) on the public URL.
# -----------------------------------------------------------------------------
ALETHEIA_DEMO_TOKEN=

# -----------------------------------------------------------------------------
# 7. Feature flags + experiment controls (CLAUDE.md §7).
#    Defaults live in core/config.py; override here for local runs / ablations.
# -----------------------------------------------------------------------------
ALETHEIA_ENABLE_CONSOLIDATION=true
ALETHEIA_ENABLE_FORGETTING=true
ALETHEIA_ENABLE_GOSSIP=true
ALETHEIA_ENABLE_IMMUNE=true
ALETHEIA_RETRIEVAL_BUDGET_TOKENS=4000
ALETHEIA_TEMPERATURE=0.2
ALETHEIA_SEED=0
